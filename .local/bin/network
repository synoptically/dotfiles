#!/bin/sh
# Icon shows link state: wifi, ethernet, no internet, or not connected.
# A lock follows the icon when a VPN is up.
s=$(nmcli -t -f TYPE,STATE device)
case $s in
    *ethernet:connected*) i='\xf3\xb0\x88\x80' ;;
    *wifi:connected*) i='\xf3\xb0\x96\xa9' ;;
    *) i='\xf3\xb0\x96\xaa' ;;
esac
case $i in
    *x96\\xaa) ;;
    *) case $(nmcli networking connectivity) in
        none|limited|portal) i='\xf3\xb0\xa4\xae' ;;
    esac ;;
esac
printf "$i"
if nmcli -t -f TYPE connection show --active | grep -qE '^(vpn|wireguard|tun)$' ||
   ls /sys/class/net | grep -qE '^(tun|wg|tailscale|ppp)'; then
    printf '\xf3\xb0\x8c\xbe'
fi
