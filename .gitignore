# Ignore everything at every depth by default.
# To track a path, add a ! line below. Re-include its parent dirs too,
# or git will not look inside them.
*

!/.gitignore
!/README.md

!/wallpapers/
!/wallpapers/2880477-1278835161.jpg
!/.bashrc
!/.bash_profile
!/.bash_logout
!/.profile
!/.xprofile
!/.xinitrc
!/.fehbg
!/pipewire.sh

!/.local/
!/.local/bin/
!/.local/bin/bluetooth
!/.local/bin/check-dotfiles
!/.local/bin/gen-screens
!/.local/bin/clock
!/.local/bin/network
!/.local/bin/power
!/.local/bin/sober
!/.local/bin/statusbar
!/.local/bin/volume

!/.config/
!/.config/alacritty/
!/.config/alacritty/alacritty.toml
!/.config/flameshot/
!/.config/flameshot/flameshot.ini
!/.config/mimeapps.list
!/.config/neofetch/
!/.config/neofetch/config.conf
!/.config/nvim/
!/.config/nvim/**
!/.config/opencode/
!/.config/opencode/AGENTS.md

!/dwm-6.8/
!/dwm-6.8/**
/dwm-6.8/dwm
/dwm-6.8/*.orig

!/Projects/
!/Projects/dwmblocks-luke/
!/Projects/dwmblocks-luke/**
/Projects/dwmblocks-luke/.git
/Projects/dwmblocks-luke/dwmblocks

# Build outputs, anywhere.
*.o
